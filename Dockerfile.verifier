FROM rust:1.95.0-bookworm@sha256:4c2fd73ef19c5ef9d54bee03b06b2839a392604fbfcd578ed948b71b37c1d7fb AS builder
WORKDIR /build

ARG CYNTRISEC_BUILD_SHA=unknown
ENV CYNTRISEC_BUILD_SHA=${CYNTRISEC_BUILD_SHA}

# Copy workspace root files
COPY Cargo.toml Cargo.lock ./

# Copy the verifier dependency graph first.
COPY common/ common/
COPY client/ client/
COPY verifier-api/ verifier-api/

# Cargo validates every workspace member before building a selected package.
# Use the real manifests and sources so --locked verifies the committed lockfile
# instead of silently resolving against synthetic workspace packages.
COPY host/ host/
COPY enclave/ enclave/
COPY gateway-api/ gateway-api/
COPY compliance/ compliance/
COPY ephemeralml-doctor/ ephemeralml-doctor/
COPY ephemeralml-smoke-test/ ephemeralml-smoke-test/

RUN cargo build --release --locked -p ephemeralml-verifier-api

FROM gcr.io/distroless/cc-debian13:nonroot@sha256:54df941ed0d06a1bd95ef5e0ce391fd8d9f94b64782dc9a60062727849ee3f97
ARG CYNTRISEC_BUILD_SHA=unknown
LABEL org.opencontainers.image.title="Cyntrisec Verification Center" \
      org.opencontainers.image.source="https://github.com/cyntrisec/EphemeralML" \
      org.opencontainers.image.revision="${CYNTRISEC_BUILD_SHA}"
COPY --from=builder /build/target/release/ephemeralml-verifier /app/ephemeralml-verifier
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/app/ephemeralml-verifier"]
