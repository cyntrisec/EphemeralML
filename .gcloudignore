# .gcloudignore — controls what gcloud uploads for Cloud Build.
# Must be kept tight to avoid multi-GB uploads.
# Dockerfile.gcp and Dockerfile.gpu build the enclave from the root Cargo
# workspace, so every workspace member must remain in the upload context.

# Rust build artifacts
target/
.target_codex/
.target_*/

# Git / IDE / OS
.git/
.github/
.vscode/
.idea/
.DS_Store
*.swp
*~

# Terraform
.terraform/
*.tfstate
*.tfstate.*

# Environment / secrets
.env
.env.*
keys/
*.log
*.pid

# Large directories not needed for enclave image builds
test_assets/
artifacts/
examples/
scripts/
site/
docs/
spec/
evidence/
attestation-evidence/
demo-artifacts/
demo-pack/
infra/
benchmark_results/
pilot/
pilot-evidence/
nvidia-disclosures/
enclaves/
manifests/
tests/
AGENTS/
investor/

# AWS Nitro artifacts
*.eif
enclave.dockerfile

# Python
env/
venv/
__pycache__/

# Markdown (not needed for build)
*.md

# Claude workspace
.claude/
